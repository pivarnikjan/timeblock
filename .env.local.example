# Copy to .env.local and fill in from Google Cloud Console → APIs & Services → Credentials.
# OAuth client type: Web application.
# Authorised redirect URI must be exactly: http://localhost:4321/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only change if you run the app on a different port or host.
TIMEBLOCK_BASE_URL=http://localhost:4321
